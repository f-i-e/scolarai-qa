# Origin only (scheme + host). Do NOT append /v1 or /api/v1 here.
SCHOLARAI_API_BASE_URL=https://api.testing.scolarai.com

# If POST …/auth/register returns HTTP 500, that is a backend issue (email, DB, secrets), not a bad test URL.

# Synthetic register emails: {prefix}+{timestamp}.{rand}@<domain> — change if your API allowlists domains
# SCHOLARAI_TEST_EMAIL_DOMAIN=qa.scolarai.test

# Prefix before routes. Default /v1 (api.testing OpenAPI). Legacy test-api: /api/v1
# In GitHub Actions, leave this variable **unset** (do not create an empty repo var) or set explicitly.
# SCHOLARAI_API_VERSION_PREFIX=/v1

# Optional: override full path for a single route
# SCHOLARAI_PATH_REGISTER=/v1/auth/register

# Verified account — tests call login, then POST /auth/refresh if the body has refreshToken only (api.testing)
SCHOLARAI_VERIFIED_USER_EMAIL=
SCHOLARAI_VERIFIED_USER_PASSWORD=

# Lesson routes: default `/v1/lessons` with slug at `…/slug/{slug}`. Legacy flat style:
# SCHOLARAI_LESSONS_PATH=/v1/lessons
# SCHOLARAI_LESSON_SLUG_STYLE=flat

# TC05 — POST …/auth/verify body { "otp_code": number }
SCHOLARAI_VALID_OTP_CODE=

# TC11 — expired access JWT (default protected URL: GET …/v1/auth/me)
SCHOLARAI_EXPIRED_ACCESS_TOKEN=
SCHOLARAI_PROTECTED_SMOKE_URL=

# TC17–TC20 — paths from site root, e.g. /v1/tutor/classes (or full https URL)
SCHOLARAI_URL_TUTOR_ONLY=
SCHOLARAI_URL_STUDENT_ONLY=
SCHOLARAI_URL_PARENT_ONLY=
SCHOLARAI_URL_ADMIN_ONLY=
SCHOLARAI_PARENT_ACCESS_TOKEN=

SCHOLARAI_RUN_RATE_LIMIT=0
SCHOLARAI_ALLOW_OFFLINE=0
